# --- Infra ---
ALLY_ENV=development
PROJECT_NAME=Ally
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_OPERATION_TIMEOUT_SECONDS=10
QDRANT_COLLECTION=document_chunks_bge_base_en_v1_5
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Process-wide model inference admission. Defaults serialize model calls,
# allow eight waiting calls, and reject a waiter after 30 seconds.
MODEL_INFERENCE_CONCURRENCY=1
MODEL_INFERENCE_MAX_WAITERS=8
MODEL_INFERENCE_WAIT_TIMEOUT_SECONDS=30
POSTGRES_DSN=postgresql://assistant:assistant@localhost:5432/assistant_db
BM25_INDEX_PATH=
# Full BM25 rebuilds are debounced to at most one per this many seconds;
# see services/retrieval/bm25_index.py and bm25_rebuild_worker.py.
BM25_REBUILD_MIN_INTERVAL_SECONDS=60
# Max accepted upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800
# Use S3 references when API and Temporal workers run on separate hosts.
# The local backend is suitable only when both processes share UPLOAD_DIR.
INGESTION_STORAGE_BACKEND=local
INGESTION_S3_BUCKET=
# Maximum compressed or expanded JSON artifact size (default 256 MiB).
INGESTION_ARTIFACT_MAX_BYTES=268435456

# --- Existing infrastructure ---
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_CONNECT_TIMEOUT_SECONDS=10
TEMPORAL_PROBE_TIMEOUT_SECONDS=5

# --- OCR ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
TEXTRACT_S3_BUCKET=

# --- LLM providers (LiteLLM routes across these) ---
QWEN_VLLM_BASE_URL=http://localhost:8002/v1
QWEN_MODEL_NAME=Qwen/Qwen3-7B
OPENAI_API_KEY=
LLM_FALLBACK_MODEL=gpt-4o-mini
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# LLM gateway resilience
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# Chat
CHAT_RETRIEVAL_TOP_K=5
CHAT_HISTORY_MAX_MESSAGES=20
MONGO_DB_NAME=ally
# History retention is an even number (complete user/assistant pairs).
# max messages * message bytes must fit within the 8 MiB content budget.
CHAT_HISTORY_MESSAGE_MAX_BYTES=65536
MONGO_CONNECT_TIMEOUT_MS=2000
MONGO_OPERATION_TIMEOUT_MS=3000
MONGO_MAX_POOL_SIZE=16

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Agent tool integrations ---
# Which Jira Cloud instance JiraTool talks to once real API calls are
# wired in (currently mocked). Per-tenant OAuth tokens live in the
# connected_accounts vault below, not here.
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# Fernet key for the connected-accounts vault (services/agent/connected_accounts.py).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before connecting any Jira/Drive/Calendar account; there is no
# plaintext fallback.
CONNECTED_ACCOUNTS_ENCRYPTION_KEY=

# Which intent classifier routes a chat message to RAG vs a tool. "llm"
# is the only one registered today; see services/agent/classifier.py for
# how to register a custom one (e.g. "jev").
INTENT_CLASSIFIER=llm

# How long the backend waits for a connected local PC agent to execute a
# command before giving up.
PC_AGENT_COMMAND_TIMEOUT_SECONDS=30

# --- HuggingFace ---
HF_TOKEN=
# Authentication/transport: production requires TLS and disables URL API keys.
WS_ALLOWED_ORIGINS=
WS_TICKET_TTL_SECONDS=30
WS_MAX_CONNECTIONS=256
WS_MAX_CONNECTIONS_PER_TENANT=8
WS_MESSAGE_MAX_BYTES=65536
WS_IDLE_TIMEOUT_SECONDS=300
WS_SESSION_MAX_SECONDS=900
